# Model APIs — the generator can use any model whose provider is configured.
# Provider auto-detected from the MODEL string (claude-* / gpt-*|o1*|o3*|o4* / gemini-*).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Supabase — analytics aggregates and stored briefs (can be empty for v0)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Resend — outbound notification emails
RESEND_API_KEY=
NOTIFY_EMAIL=jordanalexanderpitts@gmail.com

# Behaviour flags
DRY_RUN=false
MODEL=claude-opus-4-7
REVIEW_MODEL=claude-haiku-4-5-20251001

# ---- Marketing automation ----
# Master kill switch. When 'false', no marketing happens at all (no drafts, no posts).
MARKETING_ENABLED=true

# Per-channel autopost flags. When false (default), drafts are still written but no API call is made.
MARKETING_AUTOPOST_BLUESKY=false
MARKETING_AUTOPOST_MASTODON=false
MARKETING_AUTOPOST_X=false
MARKETING_AUTOPOST_NEWSLETTER=false

# Channel credentials (only needed when the corresponding AUTOPOST is true)
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=
BUTTONDOWN_API_KEY=
