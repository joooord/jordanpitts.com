      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\" />\n  <title>Jordan Pitts</title>\n  <meta name=\"description\" content=\"Jordan Pitts — jordanpitts.com. v0: a river, seen from above.\" />\n  <meta name=\"theme-color\" content=\"#0b140d\" />\n  <link rel=\"canonical\" href=\"https://jordanpitts.com/\" />\n  <script src=\"/_/analytics.js\" defer></script>\n\n  <!-- Favicons -->\n  <link rel=\"icon\" href=\"/assets/icons/favicon.ico\" sizes=\"any\" />\n  <link rel=\"icon\" href=\"/assets/icons/favicon.svg\" type=\"image/svg+xml\" />\n  <link rel=\"icon\" href=\"/assets/icons/favicon-32x32.png\" type=\"image/png\" sizes=\"32x32\" />\n  <link rel=\"icon\" href=\"/assets/icons/favicon-16x16.png\" type=\"image/png\" sizes=\"16x16\" />\n  <link rel=\"apple-touch-icon\" href=\"/assets/icons/apple-touch-icon.png\" />\n  <link rel=\"manifest\" href=\"/site.webmanifest\" />\n\n  <!-- Open Graph / Facebook / LinkedIn / iMessage -->\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:site_name\" content=\"Jordan Pitts\" />\n  <meta property=\"og:title\" content=\"Jordan Pitts\" />\n  <meta property=\"og:description\" content=\"v0 — a river, seen from above. jordanpitts.com\" />\n  <meta property=\"og:url\" content=\"https://jordanpitts.com/\" />\n  <meta property=\"og:image\" content=\"https://jordanpitts.com/assets/img/river-v0-og.jpg\" />\n  <meta property=\"og:image:width\" content=\"1200\" />\n  <meta property=\"og:image:height\" content=\"630\" />\n  <meta property=\"og:image:alt\" content=\"Aerial view of a dark river through green floodplain, a lone man drifting downstream\" />\n\n  <!-- Twitter / X -->\n  <meta name=\"twitter:card\" content=\"summary_large_image\" />\n  <meta name=\"twitter:title\" content=\"Jordan Pitts\" />\n  <meta name=\"twitter:description\" content=\"v0 — a river, seen from above. jordanpitts.com\" />\n  <meta name=\"twitter:image\" content=\"https://jordanpitts.com/assets/img/river-v0-og.jpg\" />\n\n  <link rel=\"preload\" as=\"image\" href=\"/assets/img/river-v0-poster.jpg\" />\n  <style>\n    html, body {\n      margin: 0;\n      padding: 0;\n      height: 100%;\n      width: 100%;\n      background: #0b140d;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    }\n    #bg, #poster {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 100vw;\n      height: 100vh;\n      height: 100dvh; /* fills the screen on mobile incl. browser chrome */\n      object-fit: cover;\n      object-position: center;\n    }\n    /* poster sits under the video so there is never a black flash on load */\n    #poster { z-index: 0; }\n    #bg {\n      z-index: 1;\n      opacity: 0;\n      transition: opacity 1.2s ease;\n    }\n    #bg.ready { opacity: 1; }\n    /* soft cinematic vignette; lets the controls read against bright water */\n    #shade {\n      position: fixed;\n      inset: 0;\n      z-index: 2;\n      pointer-events: none;\n      background:\n        radial-gradient(120% 90% at 50% 40%, rgba(0,0,0,0) 55%, rgba(0,0,0,0.28) 100%),\n        linear-gradient(to top, rgba(0,0,0,0.22) 0%, rgba(0,0,0,0) 22%);\n    }\n    /* ---- Liquid-glass iridescent email button ---- */\n    #email {\n      position: fixed;\n      z-index: 3;\n      left: 50%;\n      bottom: calc(26px + env(safe-area-inset-bottom));\n      transform: translateX(-50%);\n      width: 46px;\n      height: 46px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border-radius: 50%;\n      text-decoration: none;\n      color: #ffffff;\n      background: rgba(255, 255, 255, 0.14);\n      -webkit-backdrop-filter: blur(16px) saturate(180%);\n      backdrop-filter: blur(16px) saturate(180%);\n      border: 1px solid rgba(255, 255, 255, 0.4);\n      /* one clean inset edge — a single solid glass pane, no 3d bevel */\n      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.55);\n      transition: transform 0.22s cubic-bezier(.2,.8,.2,1),\n                  border-color 0.22s ease;\n      -webkit-tap-highlight-color: transparent;\n      isolation: isolate;\n    }\n    /* iridescent rotating sheen on the rim — river light: jade, lime, cream, a thread of gold */\n    #email::before {\n      content: \"\";\n      position: absolute;\n      inset: -1px;\n      border-radius: 50%;\n      padding: 1.5px;\n      background: conic-gradient(from 210deg,\n        #a7f3d0, #bef264, #fef3c7, #f5f5f4,\n        #6ee7b7, #fbbf24, #a7f3d0);\n      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n      -webkit-mask-composite: xor;\n      mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n      mask-composite: exclude;\n      opacity: 0.42;\n      animation: spin 9s linear infinite;\n      pointer-events: none;\n    }\n    /* single clean sheen — a soft light sweep, not a beveled highlight */\n    #email::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      border-radius: 50%;\n      background: linear-gradient(150deg,\n        rgba(255,255,255,0.5) 0%,\n        rgba(255,255,255,0.14) 26%,\n        rgba(255,255,255,0) 52%);\n      pointer-events: none;\n    }\n    @keyframes spin { to { transform: rotate(360deg); } }\n    #email:hover {\n      transform: translateX(-50%) translateY(-2px) scale(1.06);\n      border-color: rgba(255, 255, 255, 0.3);\n    }\n    #email:active {\n      transform: translateX(-50%) translateY(0) scale(0.96);\n    }\n    #email:focus-visible {\n      outline: 2px solid rgba(255,255,255,0.85);\n      outline-offset: 3px;\n    }\n    #email svg {\n      position: relative;\n      z-index: 1;\n      width: 19px;\n      height: 19px;\n      filter: drop-shadow(0 0.5px 1px rgba(0, 0, 0, 0.22));\n    }\n    /* ---- Iteration mark: version, date, archive. Quiet, but readable (AA on the dark pill). ---- */\n    #mark {\n      position: fixed;\n      z-index: 3;\n      left: calc(16px + env(safe-area-inset-left));\n      bottom: calc(18px + env(safe-area-inset-bottom));\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      padding: 6px 11px 6px 12px;\n      border-radius: 999px;\n      font-size: 11.5px;\n      letter-spacing: 0.04em;\n      line-height: 1;\n      color: rgba(255, 255, 255, 0.92);\n      background: rgba(6, 12, 8, 0.48);\n      -webkit-backdrop-filter: blur(12px) saturate(140%);\n      backdrop-filter: blur(12px) saturate(140%);\n      border: 1px solid rgba(255, 255, 255, 0.18);\n      font-variant-numeric: tabular-nums;\n    }\n    #mark .dot { opacity: 0.45; }\n    #mark a {\n      color: inherit;\n      text-decoration: underline;\n      text-underline-offset: 3px;\n      text-decoration-color: rgba(255,255,255,0.45);\n      transition: text-decoration-color 0.2s ease;\n    }\n    #mark a:hover { text-decoration-color: rgba(255,255,255,0.95); }\n    #mark a:focus-visible {\n      outline: 2px solid rgba(255,255,255,0.85);\n      outline-offset: 3px;\n      border-radius: 3px;\n    }\n    @media (prefers-reduced-motion: reduce) {\n      #email::before { animation: none; }\n      #bg { display: none; }\n    }\n  </style>\n</head>\n<body>\n  <img id=\"poster\" src=\"/assets/img/river-v0-poster.jpg\" alt=\"Aerial view of a dark river winding through a green floodplain. A lone man drifts downstream on his back, a wake spreading behind him.\" decoding=\"async\" fetchpriority=\"high\" />\n\n  <video id=\"bg\" autoplay loop muted playsinline preload=\"auto\" disablepictureinpicture poster=\"/assets/img/river-v0-poster.jpg\" aria-hidden=\"true\" tabindex=\"-1\">\n    <source src=\"/assets/video/river-v0.mp4\" type=\"video/mp4\" />\n  </video>\n\n  <div id=\"shade\"></div>\n\n  <p id=\"mark\">\n    <span>v0</span>\n    <span class=\"dot\" aria-hidden=\"true\">·</span>\n    <time datetime=\"2026-09-07\">2026-09-07</time>\n    <span class=\"dot\" aria-hidden=\"true\">·</span>\n    <a href=\"/archive/\">archive</a>\n  </p>\n\n  <a id=\"email\" href=\"mailto:jordan@jordanpitts.com\" aria-label=\"Email Jordan\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n      <rect x=\"2.5\" y=\"4.5\" width=\"19\" height=\"15\" rx=\"2.5\" stroke=\"currentColor\" stroke-width=\"2\"/>\n      <path d=\"M3 6l9 6.5L21 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </svg>\n  </a>\n\n  <script>\n    // Make sure the video keeps playing even if a browser pauses it,\n    // and only reveal it once frames are actually flowing (no black flash).\n    var v = document.getElementById('bg');\n    function play() {\n      var p = v.play();\n      if (p && p.catch) { p.catch(function () {}); }\n    }\n    function reveal() { v.classList.add('ready'); }\n    v.addEventListener('playing', reveal, { once: true });\n    v.addEventListener('loadeddata', function () { if (v.readyState >= 2 && !v.paused) reveal(); }, { once: true });\n    play();\n    document.addEventListener('visibilitychange', function () {\n      if (!document.hidden) play();\n    });\n    document.addEventListener('touchstart', play, { once: true });\n    document.addEventListener('click', play, { once: true });\n  </script>\n</body>\n</html>\n"
